                        <?php else: ?>
                            <img src="files/templates/images/mdi_legal.png" alt="icon">
                        <?php endif; ?>
                    </div>
                    <h3 class="cluster-title"><?= htmlspecialchars($cluster['title']) ?></h3>
                    <p class="cluster-description"><?= htmlspecialchars($cluster['description']) ?></p>
                </a>
                <?php endforeach; ?>
