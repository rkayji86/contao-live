{
    "name": "contao/managed-edition",
    "description": "Contao Managed Edition",
    "license": "LGPL-3.0-or-later",
    "type": "project",
    "require": {
        "contao/conflicts": "@dev",
        "contao/faq-bundle": "^4.13",
        "contao/listing-bundle": "^4.13",
        "contao/manager-bundle": "4.13.*",
        "menatwork/contao-multicolumnwizard-bundle": "^3.4",
        "ivoschimani/loadscripts": "^0.1.12",
        "ivoschimani/protectpage": "^0.1.9",
        "terminal42/contao-url-rewrite": "^1.7",
        "contao/news-bundle": "^4.13",
        "hofff/contao-social-tags": "^2.0",
        "cubex-hro/contao-openai-bundle": "^0.2.1",
        "terminal42/notification_center": "^2.3",
        "nelmio/security-bundle": "^2.12",
        "madeyourday/contao-rocksolid-custom-elements": "*",
        "digiwerft/gutscheinwerft": "^0.1.11"
    },
    "conflict": {
        "contao-components/installer": "<1.3"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "contao-community-alliance/composer-plugin": true,
            "contao-components/installer": true,
            "contao/manager-plugin": true,
            "php-http/discovery": false
        }
    },
    "extra": {
        "contao-component-dir": "assets"
    },
    "scripts": {
        "post-install-cmd": [
            "@php vendor/bin/contao-setup"
        ],
        "post-update-cmd": [
            "@php vendor/bin/contao-setup"
        ]
    },
    "autoload": {
        "classmap": [
            "src/ContaoManagerPlugin.php"
        ],
        "psr-4": {
            "AutometaBundle\\": "src/AutometaBundle/",
            "ContentElements\\": "src/ContentElements/",
            "FormAdd\\": "src/FormAdd/",
            "Ivo21\\EmailForContent\\": "src/Ivo21/EmailForContent/",
            "": "src/",
            "Contao\\": [
                "src/ContentElements/Models"
            ]
        }
    }
}