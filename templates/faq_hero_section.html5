<!-- Hero/Search Section -->
<style>
#faq-search:focus{
    border: none;
    box-shadow: none;
}
</style>
<div class="hero-section mb-5">
    <div class="search-container">
        <h1 class="search-title"><?= $this->heroTitle ?: 'How can we help?' ?></h1>

        <div class="search-box mb-3">
            <i class="fas fa-search search-icon"></i>
            <input type="text" id="faq-search" value="<?= \Contao\StringUtil::specialchars($this->searchQuery ?? '') ?>" placeholder="<?= $this->searchPlaceholder ?: 'Search for answers...' ?>" class="form-control">
        </div>
        
       <div class="faq-items" id="faq-search-results" style="display:none;"></div>

        <!-- <?php if ($this->popularTopics): ?>
        <div class="popular-topics mb-5">
            <span class="topics-title"><?= $this->topicsTitle ?: 'Popular Topics:' ?></span>
            <?php foreach ($this->popularTopics as $topic): ?>
            <button class="topic-btn"><?= $topic ?></button>
            <?php endforeach; ?>
        </div>
        <?php endif; ?> -->
    </div>
</div>

<script>
const FAQ_SEARCH_URL = "<?= rtrim(\Contao\Environment::get('base'), '/') ?>/_faq/search";
document.addEventListener('DOMContentLoaded', function () {
    const input = document.getElementById('faq-search');
    const resultsBox = document.getElementById('faq-search-results');

    let controller = null;
    const lang = "<?= $GLOBALS['TL_LANGUAGE'] ?? 'de' ?>";

    function showResults(items) {
        resultsBox.innerHTML = '';

        if (!items.length) {
            const noResultsText = (lang === 'de') ? 'Keine Ergebnisse gefunden…' : 'No results found…';
            resultsBox.innerHTML = `<div class="no-results">${noResultsText}</div>`;
        } else {
            items.forEach(item => {
                const el = document.createElement('div');
                el.className = 'faq-item';
                el.innerHTML = `
                    <i class="fas fa-search faq-icon"></i>
                    <div class="faq-content">
                        <div class="faq-question">${item.question}</div>
                        <div class="faq-answer">${item.answer}</div>
                    </div>
                    <div class="faq-arrow"><i class="fa-solid fa-arrow-right"></i></div>
                `;
                resultsBox.appendChild(el);
            });
        }

        resultsBox.style.display = 'block';
        resultsBox.classList.add('show');
    }

    input.addEventListener('input', function () {
        const q = this.value.trim();

        if (q.length < 3) {
            resultsBox.style.display = 'none';
            return;
        }

        if (controller) controller.abort();
        controller = new AbortController();

        fetch(FAQ_SEARCH_URL + '?q=' + encodeURIComponent(q) + '&cluster=<?= urlencode($this->selectedCluster) ?>' + '&lang=<?= isset($GLOBALS['objPage']) ? substr($GLOBALS['objPage']->language, 0, 2) : 'de' ?>', {
            signal: controller.signal
        })
        .then(r => {
            return r.json();
        })
        .then(items => {
            showResults(items);
        })
        .catch(err => {
            if (err.name === 'AbortError') {
                return;
            }
        });
    });

    input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();

            const q = this.value.trim();
            if (!q) return;

            const url = new URL(window.location.href);
            const pathParts = url.pathname.split('/').filter(Boolean);

            if (pathParts.length && pathParts[0].length === 2) {
                url.pathname = '/' + pathParts[0] + '/faq.html';
            } else {
                url.pathname = '/faq.html';
            }

            window.location.href = "<?= rtrim(\Contao\Environment::get('base'), '/') ?>"+ url.pathname + "?q="+ q;
        }
    });
});
</script>

